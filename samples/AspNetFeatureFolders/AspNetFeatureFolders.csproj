<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SampleModels\SampleModels.csproj" />
		<ProjectReference Include="..\..\src\Sg4Mvc\Sg4Mvc.csproj" />
		<ProjectReference Include="..\..\src\Sg4Mvc.Generator\Sg4Mvc.Generator.csproj" 
		                  OutputItemType="Analyzer" 
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>
	
	<ItemGroup>
		<!-- Only needed while referencing the Sg4Mvc.Generator project, it will be automatically handled when using the NuGet package -->
		<CompilerVisibleProperty Include="RunSg4Mvc" />
	</ItemGroup>
	
	<PropertyGroup>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

</Project>
